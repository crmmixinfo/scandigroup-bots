# ─────────── Umumiy ───────────
DATABASE_URL=postgresql://user:parol@host:5432/dbname
SUPER_ADMIN_ID=123456789        # /myid buyrug'i bilan oling

# ─────────── ONIX (moliyaviy bot) ───────────
ONIX_BOT_TOKEN=                 # @BotFather dan olingan token
ONIX_MINI_APP_URL=              # ixtiyoriy — rahbarlar uchun web panel

# Kunlik hisobot — har kuni shu soatda admin va rahbarlarga yuboriladi
# (kechagi kun bo'yicha). O'chirish uchun: ONIX_DAILY=off
ONIX_DAILY_TIME=09:00

# Shu summadan yuqori operatsiya haqida rahbarlarga xabar boradi.
# Bo'sh yoki 0 bo'lsa — xabar yuborilmaydi.
ONIX_NOTIFY_UZS=
ONIX_NOTIFY_USD=

# ─────────── Mavjud botlar ───────────
CANDIDATE_BOT_TOKEN=
HR_BOT_TOKEN=
MINI_APP_URL=
