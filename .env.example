# ── Baza ───────────────────────────────────────────────────────────────────
# Railway / Neon / Supabase bergan ulanish satri.
# Vercel (serverless) uchun Neon'ning POOLED satrini oling — ichida `-pooler`
# bo'ladi. Pooler'siz satr bilan bir necha parallel so'rovdayoq baza
# ulanish limiti tugaydi.
DATABASE_URL=postgresql://user:parol@host:5432/dbname
# Lokal Postgres uchun (SSL yo'q) — serverda bu qatorni QO'YMANG
# PGSSL=off

# ── ERP ────────────────────────────────────────────────────────────────────
PORT=3000
SESSION_DAYS=30
# Server ko'tarilishida bazani o'zi yaratadi/yangilaydi (Railway, Render uchun qulay).
# Vercel'da QO'YMANG: u yerda migratsiya deploy paytida `vercel-build` orqali
# bir marta bajariladi, har so'rovda emas.
ERP_AUTO_MIGRATE=1

# ── Telegram ───────────────────────────────────────────────────────────────
# Mini App imzosini tekshirish uchun. Mavjud HR bot tokeni ishlatilsa bo'ladi.
HR_BOT_TOKEN=
# Yoki ERP uchun alohida bot ochilsa:
# ERP_BOT_TOKEN=

# ── Mavjud botlar ──────────────────────────────────────────────────────────
CANDIDATE_BOT_TOKEN=
SUPER_ADMIN_ID=
MINI_APP_URL=
