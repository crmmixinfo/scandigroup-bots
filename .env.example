# ─────────── Umumiy ───────────
DATABASE_URL=postgresql://user:parol@host:5432/dbname
SUPER_ADMIN_ID=123456789        # /myid buyrug'i bilan oling

# ─────────── ONIX (moliyaviy bot) ───────────
ONIX_BOT_TOKEN=                 # @BotFather dan olingan token
ONIX_MINI_APP_URL=              # ixtiyoriy — rahbarlar uchun web panel

# Kunlik hisobot — har kuni shu soatda admin va rahbarlarga yuboriladi
# (kechagi kun bo'yicha). O'chirish uchun: ONIX_DAILY=off
ONIX_DAILY_TIME=09:00

# ─────────── Zaxira nusxa ───────────
# Har kuni shu soatda bazaning to'liq nusxasi olinadi va adminlarga
# Telegramda yuboriladi. O'chirish uchun: ONIX_BACKUP=off
ONIX_BACKUP_TIME=03:00

# Nusxa qaysi papkaga tushsin. Bo'sh qoldirilsa bot bulut papkasini o'zi
# topadi (OneDrive, Google Drive, iCloud, Dropbox, Yandex — qaysi biri
# o'rnatilgan bo'lsa) va ichida «ONIX zaxira» ochadi.
#   OneDrive:  ~/Library/CloudStorage/OneDrive-Personal/ONIX zaxira
#   iCloud:    ~/Library/Mobile Documents/com~apple~CloudDocs/ONIX zaxira
ONIX_BACKUP_DIR=

ONIX_BACKUP_KEEP=30             # necha kunlik nusxa saqlansin
# ONIX_BACKUP_TELEGRAM=off      # Telegramga fayl yuborilmasin
# ONIX_PG_DUMP=                 # pg_dump topilmasa — to'liq yo'li

# Shu summadan yuqori operatsiya haqida rahbarlarga xabar boradi.
# Bo'sh yoki 0 bo'lsa — xabar yuborilmaydi.
ONIX_NOTIFY_UZS=
ONIX_NOTIFY_USD=

# ─────────── Mavjud botlar ───────────
CANDIDATE_BOT_TOKEN=
HR_BOT_TOKEN=
MINI_APP_URL=
